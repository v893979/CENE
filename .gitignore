# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# IDEs & OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Temporary execution artifacts
*.log
push_to_github.bat
push_to_github.ps1

# Local backups of Terraform state/tfvars copied from Cloud Shell (never commit)
deploy/terraform/state-backup/

# Local result downloads (already-committed files stay tracked; new downloads stay local)
outputs/

# The evidence folder is always committed, whatever the patterns above say (e.g. *.log)
!evidence/
!evidence/**
